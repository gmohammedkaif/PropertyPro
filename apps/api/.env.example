# PropertyPro API environment (development defaults).
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Authentication (dev defaults; production REQUIRES strong secrets).
JWT_ACCESS_SECRET=fe16a3cd3aa7fbf7ad82a974baf1a4cfbbe526f1407ff870aa0a0311733ff2ef
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=pp_refresh
AUTH_COOKIE_SECURE=false

# Infrastructure (optional; without MONGODB_URI the API uses an in-memory auth store).
# MONGODB_URI=mongodb://localhost:27017/propertypro
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=propertypro
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=propertypro-dev-master-key
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# OPENAI_API_KEY=